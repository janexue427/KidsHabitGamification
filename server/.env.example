# Local development defaults. Copy to .env and adjust as needed.
PORT=4000

# Signing key for auth tokens. The server refuses to start in production while
# this is unset or left at the dev default — anyone knowing it could forge a
# parent login. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# Comma-separated list of origins allowed to call this API from a browser.
# Leave empty in local dev to allow any origin.
# CORS_ORIGIN=https://janexue427.github.io

# Where the SQLite file lives. Defaults to server/data/. Point this at a mounted
# disk in production so the database survives a redeploy.
# DATA_DIR=/var/data
