# Local development defaults. Copy to .env and adjust as needed.
PORT=4000

# Signing key for auth tokens. The server refuses to start in production while
# this is unset or left at the dev default — anyone knowing it could forge a
# parent login. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# Comma-separated list of origins allowed to call this API from a browser.
# Leave empty in local dev to allow any origin.
# CORS_ORIGIN=https://janexue427.github.io

# Where the SQLite file lives. Defaults to server/data/. On a host with an
# ephemeral filesystem this is just scratch space for the Turso replica.
# DATA_DIR=/var/data

# Durable storage. Leave both unset for local development and the server uses a
# plain SQLite file. Set them and it runs as a Turso embedded replica instead:
# reads come from the local file, writes go to Turso, and the replica is rebuilt
# from Turso on boot — which is what keeps data alive on a host that wipes its
# disk on every deploy.
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=<database token from the Turso dashboard>
